# Copy to .env and fill in. Validated by the Zod env schema at boot (core/config) —
# an invalid or missing required var fails startup. Secrets/infra only; business-
# tunable values (fees, limits, enabled services) live in the DB admin layer, not here.

# Runtime
NODE_ENV=development
PORT=3000

# Database (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/handshake_agent?schema=public

# LLM (LangGraph agent)
ANTHROPIC_API_KEY=
# Default model id; override only with intent.
AGENT_MODEL=claude-opus-4-8
# Public API host probed for the system-health card (non-secret; safe default).
ANTHROPIC_BASE_URL=https://api.anthropic.com

# WhatsApp — official Cloud API + Flows only (ADR-0003). Non-secret ids vs secrets noted.
WHATSAPP_PHONE_NUMBER_ID=          # non-secret id
WHATSAPP_WABA_ID=                  # non-secret id (WhatsApp Business Account id)
WHATSAPP_GRAPH_VERSION=v25.0       # non-secret; bump-able (also a candidate for JSON/DB-admin config)
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com  # default; override in tests/staging to point at a mock
WHATSAPP_ACCESS_TOKEN=             # SECRET — System User permanent token in prod
WHATSAPP_APP_SECRET=               # SECRET — HMAC key for X-Hub-Signature-256 webhook verification
WHATSAPP_VERIFY_TOKEN=             # SECRET — your chosen token for the GET webhook handshake
# WhatsApp Flows: RSA private key (PEM) to decrypt encrypted Flow payloads (KYC / confirmation / PIN).
WHATSAPP_FLOW_PRIVATE_KEY=         # SECRET — PEM; never logged
WHATSAPP_APP_ID=                   # non-secret id (Meta app id) — convenience/diagnostics
WHATSAPP_TEST_RECIPIENT=           # non-secret — test recipient MSISDN for staging sends
# Published Flow ids (set after publishing in the WhatsApp Business dashboard).
# Empty = Flow not published; the agent falls back to plain-text confirmation / web handoff.
WHATSAPP_FLOW_ID=                  # confirmation + PIN Flow (buy/sell/send)
WHATSAPP_BENEFICIARY_FLOW_ID=      # beneficiary add/select Flow (bank for sell, crypto for send)

# Wallet-as-a-Service: Blockradar (stablecoins on TRON/EVM; USDT-on-TRON at launch).
# NOTE: Blockradar has NO native BTC — BTC custody is deferred / needs a separate provider (ADR-0006).
BLOCKRADAR_API_KEY=                # SECRET
BLOCKRADAR_BASE_URL=               # see docs.blockradar.co/api-reference
BLOCKRADAR_MASTER_WALLET_ID=       # non-secret id (master wallet; per-user child addresses hang off it)
# NOTE: Blockradar deposit webhooks are authenticated with BLOCKRADAR_API_KEY (HMAC-SHA512),
# not a separate webhook secret. There is no BLOCKRADAR_WEBHOOK_SECRET.

# Email: Resend
RESEND_API_KEY=                    # SECRET
# Public API host probed for the system-health card (non-secret; safe default).
RESEND_BASE_URL=https://api.resend.com
EMAIL_FROM=Handshake <no-reply@example.com>

# Payments: Flutterwave — on-ramp generates a collection bank account for buying; off-ramp pays out on selling
FLUTTERWAVE_SECRET_KEY=            # SECRET
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_WEBHOOK_SECRET=        # SECRET — verify collection/transfer webhooks

# Agent-driven UI directive signing (ADR-0005/0006) — HMAC-SHA256 over high-trust directives
# AND the stateless WhatsApp flow_token. Empty is tolerated in dev/test (sign/verify
# fail-closed); boot guard requires it (non-empty) in production — an empty key makes the
# flow_token HMAC forgeable.
DIRECTIVE_SIGNING_KEY=             # SECRET — rotate-friendly
# Receipt signing — HMAC-SHA256 key for signed settlement receipts. Must be non-empty
# before any settlement runs (the kernel throws fail-closed if empty). Rotate independently
# of DIRECTIVE_SIGNING_KEY. Boot guard: required (non-empty) when WALLET_MOCK_MODE=false.
RECEIPT_SIGNING_KEY=               # SECRET — rotate-friendly
# Statement signing — HMAC-SHA256 key for signed PDF-statement download links. Empty is
# tolerated in dev (the public download endpoint 503s); boot guard requires it in production.
STATEMENT_SIGNING_KEY=             # SECRET — rotate-friendly

# Identity verification (NIN/BVN + liveness — vendor TBD)
KYC_PROVIDER_API_KEY=
KYC_PROVIDER_BASE_URL=
# When 'true', the MockKycProvider is active (the only adapter at launch). Flip to
# 'false' once a real NIN/BVN provider is wired into IdentityModule.
KYC_MOCK_MODE=true
# KYC encryption — symmetric key for encrypting NIN/BVN at rest. Boot guard requires it
# (non-empty) when KYC_MOCK_MODE=false so real identifiers are never stored in plaintext.
KYC_ENCRYPTION_KEY=                # SECRET — required when KYC_MOCK_MODE=false
# Web app base URL — builds the KYC web-handoff CTA: ${WEB_APP_BASE_URL}/kyc?t=<token>.
# Unset → the agent falls back to a plain-text KYC message.
WEB_APP_BASE_URL=
# Public base URL of THIS api — builds absolute statement download links (web + WhatsApp).
# Unset → the token service falls back to http://localhost:${PORT} (dev only).
PUBLIC_API_BASE_URL=

# --- Media (speech-to-text + document extraction) ---
# Mock adapters are active by default; real adapters activate when *_MOCK_MODE=false.
# TRANSCRIPTION_MOCK_MODE=true         # flip to 'false' to use OpenAI-compatible Whisper
# TRANSCRIPTION_API_KEY=               # SECRET — required when TRANSCRIPTION_MOCK_MODE=false
# TRANSCRIPTION_BASE_URL=https://api.openai.com/v1   # override for Groq/self-hosted whisper
# TRANSCRIPTION_MODEL=whisper-1        # model id passed to /audio/transcriptions
# MEDIA_EXTRACTION_MOCK_MODE=true      # flip to 'false' to use AnthropicVisionExtractionProvider
# MEDIA_EXTRACTION_MODEL=claude-opus-4-8  # model id for vision extraction; reuses ANTHROPIC_API_KEY

# Sanctions / AML screening (ComplianceModule)
# When 'true' (default at launch), MockSanctionsScreener is active — all addresses
# pass unless listed in compliance.sanctionsDenylist config. Set to 'false' to
# activate BlockradarAmlScreener (real AML lookup via Blockradar; requires the AML
# feature to be enabled on your Blockradar plan). Reuses BLOCKRADAR_API_KEY above.
SANCTIONS_MOCK_MODE=true

# Payment provider (TreasuryModule). When 'true' (default), MockPaymentProvider is
# active — deterministic fake virtual accounts / payouts, NO live Flutterwave calls
# (safe for local dev / tests without real keys). Set to 'false' to use the real
# FlutterwaveProvider (requires FLUTTERWAVE_SECRET_KEY above).
PAYMENTS_MOCK_MODE=true

# Bank name-enquiry (BeneficiariesModule). When 'true' (default), MockNameEnquiry
# is active — deterministic fake resolved names, NO live Flutterwave calls (safe for
# local dev / tests without real keys). Set to 'false' to use the real
# FlutterwaveNameEnquiry (POST /accounts/resolve; requires FLUTTERWAVE_SECRET_KEY above).
NAME_ENQUIRY_MOCK_MODE=true

# Wallet provider (WalletsModule). When 'true' (default), MockWalletProvider is
# active — deterministic fake addresses / balances / withdrawals, NO live Blockradar
# calls. Set to 'false' to use the real BlockradarProvider (requires
# BLOCKRADAR_API_KEY + BLOCKRADAR_MASTER_WALLET_ID above).
WALLET_MOCK_MODE=true

# Swap provider (Blockradar crypto-to-crypto swaps)
# When 'true' (default), MockSwapProvider is active — deterministic fake quotes and
# execute responses, NO live Blockradar calls (safe for local dev / tests / CI).
# Set to 'false' to activate BlockradarSwapProvider — requires a valid BLOCKRADAR_API_KEY
# and at least 2 enabled assets in the catalog (USDT + TRX at launch).
SWAP_MOCK_MODE=true

# Job queue — BullMQ / Redis (BQ-1)
# URL for the Redis instance backing BullMQ workers. The app uses lazyConnect so
# it boots without a live Redis; set this in staging/prod to point at the real cluster.
# Local dev default works with a local `redis-server` on 6379.
# Swap seam (BQ-2+): when workers are extracted to a standalone process, this var
# moves to the worker's env only — the API process itself never opens the connection.
REDIS_URL=redis://localhost:6379

# Admin API (WN-5 — wallet network backfill + future admin endpoints)
# Fail-closed: when unset (empty), AdminTokenGuard denies every request (403) —
# the admin endpoints ship disabled and unexploitable by default.
# Set to a long random secret (e.g. `openssl rand -hex 32`) to enable.
# Swap seam: replace AdminTokenGuard with a session/role guard once the admin UI
# + proper admin-session auth is built; this var can then be removed.
ADMIN_API_TOKEN=               # SECRET — empty = admin endpoints disabled (Bull Board only)

# Admin platform (RBAC console) — separate principal from end users
ADMIN_JWT_SECRET=              # SECRET — signs admin session JWTs (distinct from JWT_SECRET)
ADMIN_MFA_ENC_KEY=             # SECRET — 64 hex chars (openssl rand -hex 32); AES-256-GCM for TOTP secrets
ADMIN_BOOTSTRAP_TOKEN=         # SECRET — one-time first-super_admin bootstrap (honoured only when 0 admins exist)
ADMIN_SESSION_TTL_SECONDS=28800   # admin session absolute lifetime (default 8h)
ADMIN_STEP_UP_TTL_SECONDS=300     # step-up (re-auth) freshness window (default 5m)

# Auth (web sessions)
JWT_SECRET=                  # SECRET — empty disables token issuance (fail-closed)
AUTH_DEV_EXPOSE_OTP=false    # non-prod only: echo OTP/email tokens in API responses
# WEB_APP_BASE_URL is already defined above — used to build the email-verification link.

# Optional Flutterwave SANDBOX scenario key (e.g. "scenario:successful"). When set,
# sent as X-Scenario-Key on collections so the sandbox fires the pay-in webhook.
# MUST be empty in production.
FLUTTERWAVE_SCENARIO_KEY=
