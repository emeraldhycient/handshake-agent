// =============================================================================
// Admin platform & RBAC (ADM). A SEPARATE identity space from User (ADM-01): admin
// tokens never access user money endpoints and vice-versa. Granular, catalog-driven
// permissions over API routes AND web pages/menu items; every admin mutation is
// audited via the AuditLog (ADM-08) — there is no separate audit-binding table.
// =============================================================================

model AdminUser {
  id               String      @id @default(uuid(7)) @db.Uuid
  email            String      @unique
  /// Argon2id hash — never plaintext.
  passwordHash     String
  status           AdminStatus @default(pending)
  mfaEnabled       Boolean     @default(false)
  /// Encrypted TOTP secret; never returned by the API.
  mfaSecret        String?
  /// Hashed one-time MFA recovery codes; consumed atomically.
  mfaRecoveryCodes String[]
  roleId           String      @db.Uuid
  createdAt        DateTime    @default(now()) @db.Timestamptz
  acceptedAt       DateTime?   @db.Timestamptz
  lastLoginAt      DateTime?   @db.Timestamptz
  suspendedAt      DateTime?   @db.Timestamptz
  /// status = offboarded implies offboardedAt is set (access lost immediately).
  offboardedAt     DateTime?   @db.Timestamptz
  updatedAt        DateTime    @updatedAt @db.Timestamptz

  role               Role              @relation(fields: [roleId], references: [id])
  sessions           AdminSession[]
  invitationsCreated AdminInvitation[] @relation("InvitationCreatedBy")

  @@index([status])
  @@map("admin_users")
}

enum AdminStatus {
  pending
  active
  suspended
  offboarded

  @@map("admin_status")
}

model AdminSession {
  id          String    @id @default(uuid(7)) @db.Uuid
  adminUserId String    @db.Uuid
  /// Hashed JWT (jti maps to id) — never plaintext.
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  revokedAt   DateTime? @db.Timestamptz
  ipAddress   String?
  userAgent   String?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

/// A named permission set. Built-in roles (e.g. Super Admin) are immutable.
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String
  isBuiltin   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  adminUsers  AdminUser[]
  permissions RolePermissionAssignment[]
  invitations AdminInvitation[]

  @@index([isBuiltin])
  @@map("roles")
}

/// Single catalog entry guarding an API route, a web page, or a menu item — the
/// single source of truth for the permission catalog (ADM-04).
model Permission {
  id           String           @id @default(uuid(7)) @db.Uuid
  resourceType ResourceType
  /// "GET /api/admin/users" | "/admin/kyc-review" | "menu.compliance".
  resourceId   String
  action       PermissionAction
  description  String
  /// Catalog grouping for the admin UI, e.g. "Compliance".
  category     String
  createdAt    DateTime         @default(now()) @db.Timestamptz

  roles RolePermissionAssignment[]

  @@unique([resourceType, resourceId, action])
  @@index([resourceType, resourceId])
  @@index([category])
  @@map("permissions")
}

enum ResourceType {
  api_route
  web_page
  menu_item

  @@map("resource_type")
}

enum PermissionAction {
  read
  write
  delete
  execute

  @@map("permission_action")
}

/// Role ↔ Permission junction (the only many-to-many in the schema).
model RolePermissionAssignment {
  id           String   @id @default(uuid(7)) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permission_assignments")
}

/// Single-use, TTL-bounded admin invitation. Only the token hash is stored (ADM-07).
model AdminInvitation {
  id               String    @id @default(uuid(7)) @db.Uuid
  email            String
  roleId           String    @db.Uuid
  tokenHash        String    @unique
  expiresAt        DateTime  @db.Timestamptz
  acceptedAt       DateTime? @db.Timestamptz
  createdByAdminId String    @db.Uuid
  reason           String?
  createdAt        DateTime  @default(now()) @db.Timestamptz

  role      Role      @relation(fields: [roleId], references: [id])
  createdBy AdminUser @relation("InvitationCreatedBy", fields: [createdByAdminId], references: [id])

  @@index([email])
  @@index([expiresAt])
  @@map("admin_invitations")
}
