// =============================================================================
// Admin platform & RBAC (ADM). A SEPARATE identity space from User (ADM-01): admin
// tokens never access user money endpoints and vice-versa. Granular, catalog-driven
// permissions over API routes AND web pages/menu items; every admin mutation is
// audited via the AuditLog (ADM-08) — there is no separate audit-binding table.
// =============================================================================

model AdminUser {
  id               String      @id @default(uuid(7)) @db.Uuid
  email            String      @unique
  /// Operator display name (optional; defaults to the email local-part when unset).
  /// Not sensitive PII — safe to show in the admin UI + audit trails.
  displayName      String      @default("")
  /// Argon2id hash — never plaintext.
  passwordHash     String
  status           AdminStatus @default(pending)
  mfaEnabled       Boolean     @default(false)
  /// Encrypted TOTP secret; never returned by the API.
  mfaSecret        String?
  /// Hashed one-time MFA recovery codes; consumed atomically.
  mfaRecoveryCodes String[]
  roleId           String      @db.Uuid
  createdAt        DateTime    @default(now()) @db.Timestamptz
  acceptedAt       DateTime?   @db.Timestamptz
  lastLoginAt      DateTime?   @db.Timestamptz
  suspendedAt      DateTime?   @db.Timestamptz
  /// status = offboarded implies offboardedAt is set (access lost immediately).
  offboardedAt     DateTime?   @db.Timestamptz
  updatedAt        DateTime    @updatedAt @db.Timestamptz

  role               Role               @relation(fields: [roleId], references: [id])
  sessions           AdminSession[]
  invitationsCreated AdminInvitation[]  @relation("InvitationCreatedBy")
  preferences        AdminPreferences?

  @@index([status])
  @@map("admin_users")
}

/// Per-admin notification preferences (ADM Phase 8) — self-scoped: an admin edits
/// only their own row via GET/PATCH /admin/me/preferences. Consumed by the comms
/// dispatcher when addressing an operator; every change is audited.
model AdminPreferences {
  adminId           String   @id @db.Uuid
  emailAlerts       Boolean  @default(true)
  approvalMentions  Boolean  @default(true)
  weeklyDigest      Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @updatedAt @db.Timestamptz

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_preferences")
}

enum AdminStatus {
  pending
  active
  suspended
  offboarded

  @@map("admin_status")
}

model AdminSession {
  id          String    @id @default(uuid(7)) @db.Uuid
  adminUserId String    @db.Uuid
  /// Hashed JWT (jti maps to id) — never plaintext.
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  revokedAt   DateTime? @db.Timestamptz
  /// Last successful step-up (re-auth) on this session; gates money-affecting /
  /// limit-changing admin actions within ADMIN_STEP_UP_TTL_SECONDS (ADM-08).
  stepUpCompletedAt DateTime? @db.Timestamptz
  ipAddress   String?
  userAgent   String?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

/// A named permission set. Built-in roles (e.g. Super Admin) are immutable.
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String
  isBuiltin   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  adminUsers  AdminUser[]
  permissions RolePermissionAssignment[]
  invitations AdminInvitation[]

  @@index([isBuiltin])
  @@map("roles")
}

/// Single catalog entry guarding an API route, a web page, or a menu item — the
/// single source of truth for the permission catalog (ADM-04).
model Permission {
  id           String           @id @default(uuid(7)) @db.Uuid
  resourceType ResourceType
  /// "GET /api/admin/users" | "/admin/kyc-review" | "menu.compliance".
  resourceId   String
  action       PermissionAction
  description  String
  /// Catalog grouping for the admin UI, e.g. "Compliance".
  category     String
  createdAt    DateTime         @default(now()) @db.Timestamptz

  roles RolePermissionAssignment[]

  @@unique([resourceType, resourceId, action])
  @@index([resourceType, resourceId])
  @@index([category])
  @@map("permissions")
}

enum ResourceType {
  api_route
  web_page
  menu_item

  @@map("resource_type")
}

enum PermissionAction {
  read
  write
  delete
  execute

  @@map("permission_action")
}

/// Role ↔ Permission junction (the only many-to-many in the schema).
model RolePermissionAssignment {
  id           String   @id @default(uuid(7)) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permission_assignments")
}

/// Single-use, TTL-bounded admin invitation. Only the token hash is stored (ADM-07).
model AdminInvitation {
  id               String    @id @default(uuid(7)) @db.Uuid
  email            String
  roleId           String    @db.Uuid
  tokenHash        String    @unique
  expiresAt        DateTime  @db.Timestamptz
  acceptedAt       DateTime? @db.Timestamptz
  createdByAdminId String    @db.Uuid
  reason           String?
  createdAt        DateTime  @default(now()) @db.Timestamptz

  role      Role      @relation(fields: [roleId], references: [id])
  createdBy AdminUser @relation("InvitationCreatedBy", fields: [createdByAdminId], references: [id])

  @@index([email])
  @@index([expiresAt])
  @@map("admin_invitations")
}

/// Maker-checker change request (ADM Phase 7). A sensitive platform mutation is
/// captured as a PENDING request by one admin (the maker) and must be approved by a
/// DIFFERENT admin (the checker) before it is applied — the requester can never
/// self-approve (four-eyes). On approval the change is RE-EXECUTED through the
/// target service's existing atomic, idempotent, audited path (never a raw write,
/// CLAUDE.md §3.1); on rejection a reason is recorded. `payload` is the kind-specific
/// parameter bag the applier re-validates server-side — it is stored opaquely and
/// never trusted as a financial instruction. Full decision trail lives in AuditLog.
model ChangeRequest {
  id                 String              @id @default(uuid(7)) @db.Uuid
  /// pricing_change | capability_flip | tier_override | refund (grows additively).
  kind               ChangeRequestKind
  /// Human-readable target descriptor, e.g. "pricing.assets.USDT.baseRates.NGN".
  resource           String
  /// Kind-specific parameter bag, re-validated by the applier on approval.
  payload            Json
  status             ChangeRequestStatus @default(pending)
  /// The maker's justification for the change.
  reason             String
  requestedByAdminId String              @db.Uuid
  /// The checker (a different admin) who approved/rejected; null while pending.
  decidedByAdminId   String?             @db.Uuid
  /// The checker's decision reason (rejection cause / approval note); null pending.
  decisionReason     String?
  decidedAt          DateTime?           @db.Timestamptz
  createdAt          DateTime            @default(now()) @db.Timestamptz
  updatedAt          DateTime            @updatedAt @db.Timestamptz

  @@index([status])
  @@index([requestedByAdminId])
  @@map("change_requests")
}

enum ChangeRequestKind {
  pricing_change
  capability_flip
  tier_override
  refund
  notification_broadcast
  // Phase 7 (Treasury payout Approve): a maker-checker release of a queued payout.
  // On approval the applier re-drives the offending txn's settlement via the engine
  // (AdminTxnTriageService.retrySettlement) — never a raw ledger write (§3.1).
  payout_release
  // Phase 7 (Manual credit): a maker-checker credit of an end user's wallet. On
  // approval the applier routes through the engine's atomic settleManualCreditAtomic
  // (AdminManualCreditService) — never a raw ledger write (§3.1).
  manual_credit

  @@map("change_request_kind")
}

enum ChangeRequestStatus {
  pending
  approved
  rejected

  @@map("change_request_status")
}

/// An operator-applied TAG on an end user (Users directory bulk bar, ADM Phase 7).
/// A pure annotation — it moves NO money and confers NO authorization (§3.1); the
/// KYC/limit/sanctions gates are unaffected by tags. Tag application is idempotent
/// on the (userId, tag) unique and immutably audited. The applying admin is kept as
/// a plain ref (full trail in AuditLog). Distinct from a Role/permission grant.
model UserTag {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @db.Uuid
  /// Lower-cased, trimmed operator label (e.g. "vip", "watchlist").
  tag            String
  appliedByAdminId String @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tag])
  @@index([tag])
  @@map("user_tags")
}
