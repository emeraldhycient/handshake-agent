// =============================================================================
// Wallets & custody (WAL) — custodial wallets via Blockradar (master wallet →
// per-user child addresses; deposit webhooks with auto-sweep; withdraw API).
// Keys live with the provider (MPC/HSM) — we store references and addresses only,
// never private keys (NFR-1). USDT-on-TRON at launch; BTC deferred (ADR-0006).
// =============================================================================

model Wallet {
  id                String         @id @default(uuid(7)) @db.Uuid
  userId            String         @db.Uuid
  /// Network this wallet covers. One child address per (user, network) — all
  /// assets on that chain share this address (Blockradar child-address model).
  network           Network
  /// On-chain receive address (Blockradar child address). Validated before storage.
  address           String         @unique
  /// Opaque Blockradar reference (child-wallet/account id) — idempotent provisioning key.
  providerReference String
  status            WalletStatus   @default(provisioning)
  provisionedAt     DateTime?      @db.Timestamptz
  lastSyncedAt      DateTime?      @db.Timestamptz
  suspendedAt       DateTime?      @db.Timestamptz
  closedAt          DateTime?      @db.Timestamptz
  createdAt         DateTime       @default(now()) @db.Timestamptz
  updatedAt         DateTime       @updatedAt @db.Timestamptz

  user               User                  @relation(fields: [userId], references: [id])
  balances           WalletBalance[]
  deposits           DepositConfirmation[]
  withdrawalPolicies WithdrawalPolicy[]
  syncLogs           WalletSyncLog[]

  @@unique([userId, network])
  @@index([userId])
  @@index([network, status])
  @@map("wallets")
}

enum WalletStatus {
  provisioning
  active
  suspended
  closed

  @@map("wallet_status")
}

/// Cached balance snapshot (provider reads are expensive; staleTime-bounded).
/// Each row is per-asset on the network wallet (one wallet covers all assets on its chain).
model WalletBalance {
  id            String        @id @default(uuid(7)) @db.Uuid
  walletId      String        @db.Uuid
  /// Which asset this balance snapshot is for (e.g. USDT, BTC).
  asset         SupportedAsset
  /// Asset-native amount; engine-precision Decimal (38,18) per repo convention.
  amount        Decimal       @db.Decimal(38, 18)
  /// Asset decimal precision at snapshot (e.g. USDT=6, BTC=8) — denormalized for audit.
  assetDecimals Int
  source        BalanceSource
  syncedAt      DateTime      @db.Timestamptz
  createdAt     DateTime      @default(now()) @db.Timestamptz

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, asset, syncedAt])
  @@map("wallet_balances")
}

enum BalanceSource {
  provider_sync
  deposit_webhook
  manual_audit

  @@map("balance_source")
}

/// Immutable inbound-deposit record, deduped by on-chain txHash (WAL-05). Append-only.
model DepositConfirmation {
  id             String        @id @default(uuid(7)) @db.Uuid
  walletId       String        @db.Uuid
  txHash         String        @unique
  amount         Decimal       @db.Decimal(38, 18)
  assetDecimals  Int
  sourceAddress  String?
  status         DepositStatus @default(pending)
  blockHeight    BigInt?
  confirmations  Int           @default(0)
  /// Provider webhook event id (idempotent retry handling).
  webhookId      String?
  /// Plain refs (decoupled from the immutable AuditLog / Notification graphs).
  notificationId String?       @db.Uuid
  auditLogId     String?       @db.Uuid
  detectedAt     DateTime      @default(now()) @db.Timestamptz
  confirmedAt    DateTime?     @db.Timestamptz
  createdAt      DateTime      @default(now()) @db.Timestamptz

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId, confirmedAt])
  @@index([webhookId])
  @@index([status])
  @@map("deposit_confirmations")
}

enum DepositStatus {
  pending
  confirmed
  failed
  disputed

  @@map("deposit_status")
}

/// Per-wallet withdrawal controls / allow-listing (WAL-06). Only the latest active
/// policy (disabledAt IS NULL) applies; superseded policies are kept for audit.
model WithdrawalPolicy {
  id                  String        @id @default(uuid(7)) @db.Uuid
  walletId            String        @db.Uuid
  maxWithdrawalPerTx  Decimal?      @db.Decimal(38, 18)
  maxWithdrawalPerDay Decimal?      @db.Decimal(38, 18)
  requiresApproval    Boolean       @default(false)
  allowListMode       AllowListMode @default(allow_all)
  description         String?
  enabledAt           DateTime      @default(now()) @db.Timestamptz
  disabledAt          DateTime?     @db.Timestamptz
  createdAt           DateTime      @default(now()) @db.Timestamptz
  updatedAt           DateTime      @updatedAt @db.Timestamptz

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId, disabledAt])
  @@map("withdrawal_policies")
}

enum AllowListMode {
  allow_all
  allow_list_only
  deny_list

  @@map("allow_list_mode")
}

/// Provider sync/latency log (ops/observability; not business-critical). Append-only.
model WalletSyncLog {
  id             String           @id @default(uuid(7)) @db.Uuid
  walletId       String           @db.Uuid
  requestedAt    DateTime         @db.Timestamptz
  respondedAt    DateTime?        @db.Timestamptz
  latencyMs      Int?
  status         WalletSyncStatus
  errorCode      String?
  errorMessage   String?
  fetchedBalance Decimal?         @db.Decimal(38, 18)
  createdAt      DateTime         @default(now()) @db.Timestamptz

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId, requestedAt])
  @@map("wallet_sync_logs")
}

enum WalletSyncStatus {
  success
  timeout
  error
  rate_limited

  @@map("wallet_sync_status")
}

// =============================================================================
// BackfillRun — durable state for the async wallet-network backfill job (BQ-2).
//
// Lifecycle: queued → running → completed | failed.
// The coordinator BullMQ job sets totalUsers + marks running; per-user jobs
// increment scannedUsers / perNetwork counters atomically; the last per-user
// job that brings scannedUsers == totalUsers marks completed.
// =============================================================================

enum BackfillRunStatus {
  queued
  running
  completed
  failed

  @@map("backfill_run_status")
}

/// Durable record of an async wallet-network backfill operation (BQ-2).
/// Created synchronously by POST /admin/wallets/backfill-networks; updated
/// atomically by the BullMQ workers. The admin UI polls GET /admin/wallets/backfill-runs/:id.
model BackfillRun {
  id           String            @id @default(uuid(7)) @db.Uuid
  status       BackfillRunStatus @default(queued)
  dryRun       Boolean           @default(false)
  totalUsers   Int               @default(0)
  scannedUsers Int               @default(0)
  /// Per-network tally: { [network]: { alreadyHad: number; provisioned: number } }
  perNetwork   Json              @default("{}")
  /// Per-user failures: [{ userId: string; error: string }]
  failures     Json              @default("[]")
  createdAt    DateTime          @default(now()) @db.Timestamptz
  startedAt    DateTime?         @db.Timestamptz
  completedAt  DateTime?         @db.Timestamptz

  @@index([status])
  @@index([createdAt])
  @@map("backfill_runs")
}
