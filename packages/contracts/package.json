{
  "name": "@handshake-agent/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./intents": {
      "types": "./src/intents/index.ts",
      "import": "./src/intents/index.ts",
      "require": "./src/intents/index.ts",
      "default": "./src/intents/index.ts"
    },
    "./tools": {
      "types": "./src/tools/index.ts",
      "import": "./src/tools/index.ts",
      "require": "./src/tools/index.ts",
      "default": "./src/tools/index.ts"
    },
    "./dto": {
      "types": "./src/dto/index.ts",
      "import": "./src/dto/index.ts",
      "require": "./src/dto/index.ts",
      "default": "./src/dto/index.ts"
    },
    "./beneficiaries": {
      "types": "./src/beneficiaries/index.ts",
      "import": "./src/beneficiaries/index.ts",
      "require": "./src/beneficiaries/index.ts",
      "default": "./src/beneficiaries/index.ts"
    },
    "./media": {
      "types": "./src/media/index.ts",
      "import": "./src/media/index.ts",
      "require": "./src/media/index.ts",
      "default": "./src/media/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo \"contracts uses the repo prettier/tsc gates\" && exit 0"
  },
  "peerDependencies": {
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "zod": "^3.25.32"
  }
}
